  m_IsActive: 1
--- !u!114 &365129589
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 365129588}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4efef6aedbe5b87418583d07a72c5bb5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Mach.TutorialDirector
  pages:
  - lesson: 0
    title: BASIC INTERACTION
    guide: '<color=#FFD479><b>E</b></color> carry / place   <color=#FFD479><b>SCROLL</b></color> rotate


      Carry {carry} by its round knob to the red/orange pad farther ahead. Press E to confirm placement.


      WASD moves; mouse looks around. No walking checkpoint is needed.'
    keys: '<color=#FFD479><b>WASD</b></color> move

      <color=#FFD479><b>MOUSE</b></color> look

      <color=#FFD479><b>E</b></color> carry / place

      <color=#FFD479><b>SCROLL</b></color> rotate

      <color=#FFD479><b>RMB</b></color> cancel'
    requirements:
    - Place {carry} on the marked pad
    diagram: {fileID: 0}
    timeLimit: 1200
    areaCenter: {x: 500, y: 0, z: 0}
    machines: 08000000i
    showRobot: 0
    layout: {fileID: 216947541}
  - lesson: 2
    title: ROBOT DRIVING
    guide: '<color=#FFD479><b>TAB</b></color> tablet   <color=#FFD479><b>LMB</b></color> wire / CHECK


      Add DRIVING A. Connect START to DRIVING and A to PARAM. Press CHECK.


      This lesson requires CHECK before docking. Re-check if you change the circuit.


      Insert the tablet with E; watch the robot reach A.'
    keys: '<color=#FFD479><b>TAB</b></color> tablet

      <color=#FFD479><b>LMB</b></color> wire / CHECK

      <color=#FFD479><b>E</b></color> insert / remove tablet'
    requirements:
    - Build Driving A and CHECK
    - Insert tablet into robot
    - Robot reaches A
    diagram: {fileID: 1775117389}
    timeLimit: 1200
    areaCenter: {x: 500, y: 0, z: 42}
    machines: 04000000i
    showRobot: 1
    layout: {fileID: 29619394}
  - lesson: 3
    title: ROBOT FACING
    guide: '<color=#FFD479><b>LMB</b></color> connect / replace wire   <color=#FFD479><b>TAB</b></color> tablet


      A Driving circuit is prepared. Add FACING A between START and DRIVING.


      Connect START to FACING to replace the old wire, then FACING to DRIVING. A goes to both PARAM inputs.


      CHECK, dock, and watch it aim then drive to A.'
    keys: '<color=#FFD479><b>TAB</b></color> tablet

      <color=#FFD479><b>LMB</b></color> replace wire

      <color=#FFD479><b>E</b></color> insert / remove tablet'
    requirements:
    - Insert FACING between START and DRIVING
    - CHECK the modified circuit
    - Insert tablet into robot
    - Robot aims, then reaches A
    diagram: {fileID: 359403453}
    timeLimit: 1200
    areaCenter: {x: 526, y: 0, z: 42}
    machines: 0100000004000000i
    showRobot: 1
    layout: {fileID: 2068136950}
  - lesson: 4
    title: ROBOT SHOOTING
    guide: '<color=#FFD479><b>LMB</b></color> add blocks / wire   <color=#FFD479><b>TAB</b></color> tablet


      Build START > FIRE. Set AMMO to BURST and RATE to MID.


      Connect both parameters to FIRE, then CHECK and dock.


      The robot must fire using BURST at MED rate.'
    keys: '<color=#FFD479><b>LMB</b></color> machines / wire / CHECK

      <color=#FFD479><b>TAB</b></color> tablet

      <color=#FFD479><b>E</b></color> dock'
    requirements:
    - Connect BURST ammo
    - Connect MED rate
    - Complete circuit and CHECK
    - Insert tablet into robot
    - Robot fires BURST at MED rate
    diagram: {fileID: 1587251551}
    timeLimit: 1200
    areaCenter: {x: 578, y: 0, z: 42}
    machines: 020000000500000006000000i
    showRobot: 1
    layout: {fileID: 832442012}
  - lesson: 1
    title: LAUNCH BEACONS
    guide: '<color=#FFD479><b>RMB</b></color> launcher   <color=#FFD479><b>LMB</b></color> fire   <color=#FFD479><b>E</b></color> recall


      Select A with the wheel and hit WHITE BLOCK 1. Recall A.


      Select B and hit WHITE BLOCK 2 on the higher platform.'
    keys: '<color=#FFD479><b>RMB</b></color> launcher

      <color=#FFD479><b>SCROLL</b></color> select

      <color=#FFD479><b>LMB</b></color> launch

      <color=#FFD479><b>E</b></color> recall'
    requirements:
    - Launch A onto white block 1
    - Recall A
    - Launch B onto white block 2
    diagram: {fileID: 0}
    timeLimit: 1200
    areaCenter: {x: 578, y: 0, z: 0}
    machines: 
    showRobot: 0
    layout: {fileID: 468725473}
  - lesson: 8
    title: DRONE BEACONS
    guide: '<color=#FFD479><b>E</b></color> access the launch pad. Lift off and switch to drop view.


      Drop A on white block 1. Fly to white block 2, select B and drop it.


      Press R and wait for the drone to land on the pad.'
    keys: <color=#FFD479><b>E</b></color> access pad   <color=#FFD479><b>WASD</b></color> fly   <color=#FFD479><b>SHIFT / CTRL</b></color> climb / descend   <color=#FFD479><b>C</b></color> drop view   <color=#FFD479><b>SCROLL</b></color> select   <color=#FFD479><b>LMB</b></color> drop   <color=#FFD479><b>R</b></color> return
    requirements:
    - Switch to drop view
    - Drop A on white block 1
    - Drop B on white block 2
    - Return the drone to the pad
    diagram: {fileID: 0}
    timeLimit: 1200
    areaCenter: {x: 552, y: 0, z: 0}
    machines: 
    showRobot: 0
    layout: {fileID: 8100000107}
  - lesson: 5
    title: ADVANCED ROBOT SHOOTING
    guide: '<color=#FFD479><b>HOLD LMB</b></color> timer arrows   <color=#FFD479><b>TAB</b></color> tablet


      Connect the prepared actions: START > FACING > FIRE > WAIT > CEASE FIRE.


      Use POINT A, AP ammo, HIGH rate and 2 seconds.


      CHECK and dock. It must fire, wait 2 seconds, then stop.'
    keys: '<color=#FFD479><b>HOLD LMB</b></color> timer arrows

      <color=#FFD479><b>TAB</b></color> tablet

      <color=#FFD479><b>LMB</b></color> wire / CHECK

      <color=#FFD479><b>E</b></color> dock'
    requirements:
    - Connect AP ammo
    - Connect HIGH rate
    - Set WAIT to 2 seconds
    - Complete circuit and CHECK
    - Insert tablet into robot
    - Fire, wait, then cease fire
    diagram: {fileID: 823994400}
    timeLimit: 1200
    areaCenter: {x: 500, y: 0, z: 84}
    machines: 0100000002000000050000000600000008000000i
    showRobot: 1
    layout: {fileID: 859643063}
  - lesson: 6
    title: PACK AND TRANSPORT
    guide: '<color=#FFD479><b>E</b></color> pack / attach / enter   <color=#FFD479><b>LMB</b></color> door


      Pack every machine into the tray. Carry the tray to the truck bed and press E to attach.


      Open the door and enter the driver''s seat.'
    keys: '<color=#FFD479><b>E</b></color> carry / pack / enter

      <color=#FFD479><b>SCROLL</b></color> rotate

      <color=#FFD479><b>LMB</b></color> door'
    requirements:
    - Pack all equipment into tray
    - Attach loaded tray to truck
    - Enter driver's seat
    diagram: {fileID: 0}
    timeLimit: 1200
    areaCenter: {x: 526, y: 0, z: 84}
    machines: 
    showRobot: 1
    layout: {fileID: 1914232000}
  - lesson: 7
    title: FINAL TEST
    guide: '<color=#FFD479><b>E</b></color> unload / unpack   <color=#FFD479><b>R</b></color> remote


      Unload the tray and unpack all equipment. Build your circuit, CHECK, then dock.


      Use the transparent route to plan your defense. Press ENGAGE and defeat 5 ghosts.


      Complete this test to enter the main game.'
    keys: '<color=#FFD479><b>E</b></color> unload / unpack / dock

      <color=#FFD479><b>TAB</b></color> tablet

      <color=#FFD479><b>LMB</b></color> wire / CHECK

      <color=#FFD479><b>R</b></color> remote

      <color=#FFD479><b>LMB</b></color> ENGAGE'
    requirements:
    - Unload tray and unpack all equipment
    - Build circuit and CHECK
    - ENGAGE the wave
    - Defeat all 5 enemies
    diagram: {fileID: 0}
    timeLimit: 1200
    areaCenter: {x: 552, y: 0, z: 84}
